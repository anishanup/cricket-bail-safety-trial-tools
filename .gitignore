# Downloaded videos and generated highlights (inside each trial folder)
trials/*/downloads/

# Generated PDFs (pretty-printed from markdown, not versioned)
*.pdf

# ffmpeg's concat list: absolute paths from whoever built the reel
trials/*/*/reel/clips.txt

# Scrape caches (re-fetchable, not versioned)
.ntca-cache.json
.dallashub-cache.json
.milc-cache.json

# Large media files (anywhere in repo)
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.mp3
*.wav

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.venv
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (used only by md_to_pdf helper)
node_modules/
package-lock.json
package.json
